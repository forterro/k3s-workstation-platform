# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Rendered / generated artifacts (bootstrap output is disposable)
/out/
/rendered/
*.rendered.yaml

# Vendored Helm dependencies for the imperative seed (rebuilt via `helm dependency update`).
# umbrella-charts/ dependencies are vendored and committed so ArgoCD renders them reliably.
bootstrap/helm/**/charts/*.tgz
bootstrap/helm/**/Chart.lock

# Local Kubernetes / secrets material (never commit)
kubeconfig*.yaml
*.kubeconfig
*.age
age-key.txt
keys.txt
.env
.env.*

# Editor / OS
.DS_Store
*.swp
